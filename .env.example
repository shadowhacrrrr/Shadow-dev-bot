# ============================================================
# SHADOW DEV BOT - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Base URL of your deployed app (Railway/Vercel/etc)
BASE_URL=https://your-app.up.railway.app

# Admin Panel Token (for web admin access)
ADMIN_TOKEN=shadow-admin-2024

# Port (Railway will override this)
PORT=3000

# Admin Panel Port
ADMIN_PORT=3001

# Node Environment
NODE_ENV=production
